الاسم : لانا زياد ابو غالي
الرقم الجامعي : 202410639
الشعبة : 3
المادة : البرمجة التطبيقية 
واجب رقم 1
اكتب برنامج جافا يطلب من اليوزر يحسب مجموع الاعداد الفردية مجموعة الارقام الزوجية ومجموع الاعداد الاولية والمعدل بين مجموع الفردية و الاوليه ؟

Package edu.zuj.oop.lecture2;
import java.util.Scanner;

public class H.W1 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter a number (n): ");
        int n = input.nextInt();

        int choice;

        for (;;) { // infinite loop until user chooses to exit
            System.out.println("\n----- MENU -----");
            System.out.println("1. Display and sum odd numbers from 1 to n");
            System.out.println("2. Display and sum even numbers from 1 to n");
            System.out.println("3. Display and sum prime numbers from 1 to n");
            System.out.println("4. Calculate the average between odd and prime sums");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");
            choice = input.nextInt();

            if (choice == 1) {
                int oddSum = 0;
                System.out.print("Odd numbers: ");
                for (int i = 1; i <= n; i++) {
                    if (i % 2 != 0) {
                        System.out.print(i + " ");
                        oddSum += i;
                    }
                }
                System.out.println("\nSum of odd numbers = " + oddSum);
            }

            else if (choice == 2) {
                int evenSum = 0;
                System.out.print("Even numbers: ");
                for (int i = 1; i <= n; i++) {
                    if (i % 2 == 0) {
                        System.out.print(i + " ");
                        evenSum += i;
                    }
                }
                System.out.println("\nSum of even numbers = " + evenSum);
            }

            else if (choice == 3) {
                int primeSum = 0;
                System.out.print("Prime numbers: ");
                for (int i = 2; i <= n; i++) {
                    if (isPrime(i)) {
                        System.out.print(i + " ");
                        primeSum += i;
                    }
                }
                System.out.println("\nSum of prime numbers = " + primeSum);
            }

            else if (choice == 4) {
                int oddSum = 0, primeSum = 0;

                for (int i = 1; i <= n; i++) {
                    if (i % 2 != 0)
                        oddSum += i;
                }

                for (int i = 2; i <= n; i++) {
                    if (isPrime(i))
                        primeSum += i;
                }

                double average = (oddSum + primeSum) / 2.0;
                System.out.println("Average between odd and prime sums = " + average);
            }

            else if (choice == 5) {
                System.out.println("Program terminated.");
                break;
            }

            else {
                System.out.println("Invalid choice! Try again.");
            }
        }

        input.close();
    }

    // Function to check if a number is prime
    public static boolean isPrime(int num) {
        if (num < 2)
            return false;
        for (int i = 2; i <= Math.sqrt(num); i++) {
            if (num % i == 0)
                return false;
        }
        return true;
    }
}

