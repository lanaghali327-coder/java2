public class CenterTriangleStars {
    public static void main(String[] args) {
        int rows = 5; // عدد الأسطر في المثلث
        
        for (int i = 1; i <= rows; i++) {
            for (int j = i; j < rows; j++) {
                System.out.print(" ");
            }
            (عددها = 2*i - 1)
            for (int k = 1; k <= (2 * i - 1); k++) {
                System.out.print("*");
            }
            System.out.println(); 
        }
    }
}
