public class RightTriangleStars {
    public static void main(String[] args) {
        int rows = 5; 
        
        for (int i = 1; i <= rows; i++) {
                      for (int j = i; j < rows; j++) {
                System.out.print(" ");
            }
        
            for (int k = 1; k <= i; k++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
